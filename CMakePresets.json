{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 19,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "default",
        "hidden": false,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      },
      {
        "name": "debug",
        "inherits": "default",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "release",
        "inherits": "default",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "default",
        "configurePreset": "default",
        "hidden": false
      },
      {
        "name": "debug",
        "configurePreset": "debug",
        "hidden": false
      },
      {
        "name": "release",
        "configurePreset": "release",
        "hidden": false
      }
    ],
    "testPresets": [
      {
        "name": "default",
        "configurePreset": "default",
        "hidden": false,
        "execution": {
          "jobs": 4
        }
      }
    ]
  }